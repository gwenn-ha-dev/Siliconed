    "Steps are whole numbers from 1, a grid needs at least one seed, and a negative LoRA strength needs Settings › Advanced › Negative LoRA Strengths." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schritte sind ganze Zahlen ab 1, ein Raster braucht mindestens einen Seed, und eine negative LoRA-Stärke braucht Einstellungen › Erweitert › Negative LoRA-Stärken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pasos son números enteros a partir de 1, una cuadrícula necesita al menos una semilla, y una intensidad de LoRA negativa necesita Ajustes › Avanzado › Intensidades de LoRA negativas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pas sont des nombres entiers à partir de 1, une grille demande au moins une graine, et une force de LoRA négative demande Réglages › Avancé › Forces de LoRA négatives."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I passi sono numeri interi a partire da 1, una griglia richiede almeno un seme, e un’intensità di LoRA negativa richiede Impostazioni › Avanzate › Intensità LoRA negative."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステップは1以上の整数です。グリッドには少なくとも1つのシードが必要で、負のLoRA強度には「設定」›「詳細設定」›「負のLoRA強度」が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步数为从 1 起的整数，网格至少需要一个种子，负的 LoRA 强度需要“设置” › “高级” › “负 LoRA 强度”。"
          }
        }
      }
    },
