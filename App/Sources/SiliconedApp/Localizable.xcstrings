    "Check Fixed to choose the seed: unchecked, each render draws its own" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kreuzen Sie Fest an, um den Seed zu wählen: ohne Haken zieht jedes Rendering seinen eigenen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca Fija para elegir la semilla: sin marcar, cada renderizado saca la suya"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cochez Fixe pour choisir la graine : décochée, chaque rendu tire la sienne"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spunta Fisso per scegliere il seme: senza spunta, ogni rendering estrae il proprio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シードを選ぶには固定にチェック：チェックなしでは、生成ごとに新しいシードを引きます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勾选“固定”即可选择种子：不勾选时，每次渲染都会抽取自己的种子"
          }
        }
      }
    },
