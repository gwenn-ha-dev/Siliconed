          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin marcar: una semilla nueva en cada renderizado. Marcada: la misma semilla, la misma imagen otra vez"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décochée : une graine neuve à chaque rendu. Cochée : la même graine, la même image à nouveau"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
