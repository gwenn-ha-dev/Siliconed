    "Core AI compilation…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Core-AI-Kompilierung …"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compilación de Core AI…"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
