    "Connect it to render. Settings can also go back to this Mac’s library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließen Sie sie an, um zu rendern. In den Einstellungen können Sie auch zur Bibliothek dieses Mac zurückkehren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conéctalo para renderizar. En Ajustes también puedes volver a la biblioteca de este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Branchez-le pour rendre. Les Réglages peuvent aussi revenir à la bibliothèque de ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collegalo per avviare un rendering. Nelle Impostazioni puoi anche tornare alla libreria di questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続すると生成できます。「設定」でこのMacのライブラリに戻すこともできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请连接后再生成。也可以在“设置”中切回这台 Mac 的资源库。"
          }
        }
      }
    },
    "Connect the disk — or, in Settings, go back to this Mac’s library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
