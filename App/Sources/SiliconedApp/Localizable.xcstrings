    "“%@” is busy: an installation, an import or a render is running." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist beschäftigt: Eine Installation, ein Import oder ein Rendering läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» está ocupado: hay una instalación, una importación o un render en curso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est occupé : une installation, un import ou un rendu est en cours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» è occupato: è in corso un’installazione, un’importazione o un rendering."
          }
