          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac a refusé le retrait : rien n’a été retiré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quel Mac ha rifiutato la rimozione: non è stato rimosso nulla."
