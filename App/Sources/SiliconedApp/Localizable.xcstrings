          }
        }
      }
    },
    "Where the models go — an external disk, for instance. A “Siliconed” folder is made in it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wohin die Modelle kommen – etwa auf eine externe Festplatte. Darin wird ein Ordner „Siliconed“ angelegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adónde van los modelos — un disco externo, por ejemplo. Se crea dentro una carpeta «Siliconed»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Là où iront les modèles — un disque externe, par exemple. Un dossier « Siliconed » y est créé."
          }
        },
        "it" : {
