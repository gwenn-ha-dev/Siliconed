    "Stops the import: nothing half-copied enters the library, and no file of yours is touched" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppt den Import: Nichts halb Kopiertes gelangt in die Bibliothek, und keine Ihrer Dateien wird angetastet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detiene la importación: nada a medio copiar entra en la biblioteca y ninguno de tus archivos se toca"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrête l’import : rien d’à moitié copié n’entre dans la bibliothèque, et aucun de vos fichiers n’est touché"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrompe l’importazione: nulla di copiato a metà entra nella libreria e nessuno dei tuoi file viene toccato"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込みを停止します：途中までのコピーはライブラリに入らず、元のファイルには一切手を触れません"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止导入：拷贝一半的内容不会进入资源库，你的文件不会被改动"
          }
        }
      }
    },
