    "No image to edit: the render makes a new image from these, at the size chosen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Bild zum Bearbeiten: Das Rendering erstellt daraus ein neues Bild, in der gewählten Größe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna imagen que editar: el render crea una imagen nueva a partir de estas, al tamaño elegido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune image à éditer : le rendu fait une image neuve à partir de celles-ci, à la taille choisie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna immagine da modificare: il rendering crea un’immagine nuova a partire da queste, alla dimensione scelta."
          }
        },
        "ja" : {
          "stringUnit" : {
