            "state" : "translated",
            "value" : "„%@“ möchte die abgebrochenen Downloads dieses Macs leeren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» quiere vaciar las descargas interrumpidas de este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » veut vider les téléchargements interrompus de ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» vuole svuotare i download interrotti di questo Mac."
          }
        },
        "ja" : {
