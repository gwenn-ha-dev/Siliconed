          "stringUnit" : {
            "state" : "translated",
            "value" : "El motor se ha detenido de forma inesperada mientras escribía. Vuelve a intentarlo: arranca de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le moteur s’est arrêté de façon inattendue pendant l’écriture. Réessayez : il repart à neuf."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il motore si è fermato in modo imprevisto durante la scrittura. Riprova: riparte da zero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き込み中にエンジンが予期せず停止しました。もう一度お試しください。エンジンは新たに起動します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写作时引擎意外停止。请重试：引擎会重新启动。"
          }
        }
      }
    },
