          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”正忙：正在安装、导入或生成。"
          }
        }
      }
    },
    "“%@” is no longer waiting for a Mac: open its pairing window again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wartet nicht mehr auf einen Mac: öffne sein Kopplungsfenster erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» ya no espera ningún Mac: vuelve a abrir su ventana de vinculación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’attend plus de Mac : rouvrez sa fenêtre d’appairage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
