    "Install Siliconed again: the app and its engine must come from the same build." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installieren Sie Siliconed erneut: Die App und ihre Engine müssen aus demselben Build stammen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a instalar Siliconed: la app y su motor deben proceder de la misma compilación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réinstallez Siliconed : l’app et son moteur doivent venir de la même version."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinstalla Siliconed: l’app e il suo motore devono provenire dalla stessa build."
          }
