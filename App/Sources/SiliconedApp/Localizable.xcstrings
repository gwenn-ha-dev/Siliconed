    "That Mac is already asking about another removal: try again once it is answered." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac fragt bereits wegen einer anderen Entfernung: Versuchen Sie es nach der Antwort erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese Mac ya está preguntando por otra eliminación: vuelva a intentarlo cuando se responda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac demande déjà pour un autre retrait : réessayez une fois la réponse donnée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quel Mac sta già chiedendo per un’altra rimozione: riprova dopo la risposta."
          }
