        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siliconedを再インストールしてください。アプリとエンジンは同じビルドのものである必要があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请重新安装 Siliconed：应用及其引擎必须来自同一构建版本。"
          }
        }
      }
    },
    "Install it from the Models sheet (⇧⌘M), then import the file again: an import downloads nothing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
