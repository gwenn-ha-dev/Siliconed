    "That Mac declined the removal: nothing was removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac hat das Entfernen abgelehnt: Nichts wurde entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese Mac rechazó la eliminación: no se quitó nada."
          }
