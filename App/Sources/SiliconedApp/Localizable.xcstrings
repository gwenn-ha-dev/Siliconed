    },
    "Nothing in this repository can be imported: Siliconed takes a LoRA or an image model as one .safetensors file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesem Repository lässt sich nichts importieren: Siliconed nimmt eine LoRA oder ein Bildmodell als eine einzige .safetensors-Datei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada de este repositorio se puede importar: Siliconed admite un LoRA o un modelo de imagen en un único archivo .safetensors."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien dans ce dépôt ne peut être importé : Siliconed prend une LoRA ou un modèle d’image en un seul fichier .safetensors."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente in questo repository si può importare: Siliconed accetta una LoRA o un modello di immagine in un solo file .safetensors."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリポジトリには読み込めるものがありません：Siliconedが受け付けるのは、LoRAまたは画像モデルを1つの.safetensorsファイルにしたものです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此仓库中没有可导入的内容：Siliconed 只接受以单个 .safetensors 文件提供的 LoRA 或图像模型。"
          }
        }
      }
    },
    "Nothing installed" : {
