          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I gruppi di alternative non si possono annidare (carattere %@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
