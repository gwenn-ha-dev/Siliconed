    "Lets a LoRA’s strength go from −1.5 to 1.5, for “slider” LoRAs. An ordinary LoRA is damaged by a negative strength." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lässt die Stärke einer LoRA von −1,5 bis 1,5 reichen, für „Slider“-LoRAs. Eine gewöhnliche LoRA wird durch eine negative Stärke beschädigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que la fuerza de un LoRA vaya de −1,5 a 1,5, para LoRA «slider». Una fuerza negativa daña un LoRA corriente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse la force d’un LoRA aller de −1,5 à 1,5, pour les LoRA « slider ». Un LoRA ordinaire est abîmé par une force négative."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permette alla forza di un LoRA di andare da −1,5 a 1,5, per i LoRA «slider». Una forza negativa danneggia un LoRA ordinario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LoRA の強さを −1.5〜1.5 にできます。「スライダー」LoRA 用で、通常の LoRA は負の強さで画像が崩れます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 LoRA 的强度在 −1.5 至 1.5 之间，适用于“slider”类 LoRA。普通 LoRA 使用负强度会受损。"
          }
        }
      }
    },
    "Letters, digits, - and _ only, without spaces." : {
      "localizations" : {
        "de" : {
