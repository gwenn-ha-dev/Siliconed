    },
    "The model sees it as context, after the image to edit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Modell sieht es als Kontext, nach dem zu bearbeitenden Bild."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo la ve como contexto, después de la imagen que editar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle la voit comme contexte, après l’image à éditer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
