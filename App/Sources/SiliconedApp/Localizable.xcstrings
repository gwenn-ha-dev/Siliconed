    "The engine decides by itself how much to give the Neural Engine, measures it, and takes it back if it does not help on this Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Engine entscheidet selbst, wie viel sie der Neural Engine überlässt, misst es und nimmt es zurück, wenn es auf diesem Mac nichts bringt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El motor decide por sí solo cuánto confiar al Neural Engine, lo mide y lo retira si no ayuda en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le moteur décide seul de la part qu’il confie au Neural Engine, la mesure, et la reprend si elle n’aide pas sur ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il motore decide da solo quanto affidare al Neural Engine, lo misura e lo riprende se su questo Mac non serve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neural Engineにどれだけ任せるかはエンジンが自分で決め、効果を測り、このMacで役に立たなければ引き上げます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引擎自行决定交给 Neural Engine 多少工作，并加以测量；若在这台 Mac 上没有帮助，就收回。"
          }
        }
      }
    },
