        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decodificado por bandas para no salir del límite de memoria de este Mac: la misma imagen, una decodificación más larga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décodé par bandes pour rester sous la limite de mémoire de ce Mac : la même image, un décodage plus long."
