    "GitHub could not be reached. New versions are also listed on the project’s page." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub war nicht erreichbar. Neue Versionen stehen auch auf der Projektseite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo contactar con GitHub. Las nuevas versiones también están en la página del proyecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub n’a pas pu être joint. Les nouvelles versions sont aussi sur la page du projet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere GitHub. Le nuove versioni sono anche sulla pagina del progetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubに接続できませんでした。新しいバージョンはプロジェクトのページにも掲載されます。"
