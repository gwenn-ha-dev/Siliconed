    "How each step moves to the next, with the same steps: Euler is the one this model was distilled for" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie jeder Schritt zum nächsten führt, bei gleichen Schritten: Euler ist der, für den dieses Modell destilliert wurde"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo cada paso lleva al siguiente, con los mismos pasos: Euler es el que se usó al destilar este modelo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment chaque pas mène au suivant, avec les mêmes pas : Euler est celui pour lequel ce modèle a été distillé"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come ogni passo porta al successivo, con gli stessi passi: Euler è quello per cui questo modello è stato distillato"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じステップ数で、各ステップから次のステップへどう進むか：このモデルが蒸留されたのはEulerです"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一步如何过渡到下一步，步数相同：Euler 是此模型蒸馏时所用的求解器"
          }
        }
      }
    },
    "How far the render moves away from the starting image: low keeps its composition and colours, %@ ignores it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie weit sich das Rendern vom Startbild entfernt: niedrig behält es Komposition und Farben, bei %@ ignoriert es das Bild."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto se aleja el renderizado de la imagen de partida: baja, conserva su composición y sus colores; al %@, la ignora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu’où le rendu s’éloigne de l’image de départ : faible, il garde sa composition et ses couleurs ; à %@, il l’ignore."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto il rendering si allontana dall’immagine di partenza: bassa, ne conserva composizione e colori; al %@, la ignora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レンダリングが開始画像からどれだけ離れるか。低いと構図と色を保ち、%@では画像を無視します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "渲染离起始图像有多远：低时保留其构图和色彩，为 %@ 时忽略它。"
          }
        }
      }
    },
    "How many seeds, one image each: consecutive seeds from the Seed’s, the prompt encoded only once" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele Seeds, je ein Bild: fortlaufende Seeds ab dem Seed, der Prompt nur einmal codiert"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuántas semillas, una imagen cada una: semillas consecutivas a partir de la Semilla, el prompt codificado una sola vez"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combien de graines, une image chacune : des graines consécutives à partir de la Graine, le prompt encodé une seule fois"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanti semi, un’immagine ciascuno: semi consecutivi a partire dal Seme, il prompt codificato una sola volta"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シードの数、1つにつき画像1枚：「シード」から連続するシードで、プロンプトのエンコードは1回だけです"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "种子数量，每个种子一张图像：从“种子”开始的连续种子，提示词只编码一次"
          }
        }
      }
    },
    "Illustration, painting and anime. No photorealism: its publisher’s choice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illustration, Malerei und Anime. Kein Fotorealismus: eine Entscheidung des Herausgebers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilustración, pintura y anime. Sin fotorrealismo: una decisión de su editor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illustration, peinture et anime. Pas de photoréalisme : un choix de son éditeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illustrazione, pittura e anime. Niente fotorealismo: una scelta del suo editore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イラスト、絵画、アニメ。フォトリアルではありません：公開元の方針です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "插画、绘画和动漫。不含照片级写实：这是其发布方的选择。"
          }
        }
      }
    },
