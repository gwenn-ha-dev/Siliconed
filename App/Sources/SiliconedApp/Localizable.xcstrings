        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imágenes estéticas, de la fotografía a la pintura. El modelo más grande, y el más lento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
