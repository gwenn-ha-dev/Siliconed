    "Glass costs a little time while an image moves under it — about half a percent of a render on a large Mac, more on a small one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glas kostet etwas Zeit, wenn sich ein Bild darunter bewegt – etwa ein halbes Prozent eines Renderings auf einem großen Mac, mehr auf einem kleinen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vidrio cuesta algo de tiempo cuando una imagen se mueve debajo: cerca de medio por ciento de un render en un Mac grande, más en uno pequeño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le verre coûte un peu de temps quand une image bouge dessous : environ un demi pour cent d’un rendu sur un grand Mac, davantage sur un petit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vetro costa un po’ di tempo quando un’immagine si muove sotto: circa mezzo punto percentuale di un rendering su un Mac grande, di più su uno piccolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ガラスは下で画像が動くあいだ少し時間を使います。大きな Mac ではレンダリングの約 0.5 %、小さな Mac ではそれ以上です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图像在玻璃下移动时会花一点时间：大 Mac 上约为一次渲染的 0.5%，小 Mac 上更多。"
          }
        }
      }
    },
    "Groups of alternatives can’t be nested (character %@)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruppen von Alternativen lassen sich nicht verschachteln (Zeichen %@)."
