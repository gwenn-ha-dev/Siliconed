    "Each new image will be saved here as a PNG, with its prompt, seed and model." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes neue Bild wird hier als PNG gesichert, mit Prompt, Seed und Modell."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada imagen nueva se guardará aquí en PNG, con su prompt, su semilla y su modelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque image nouvelle sera enregistrée ici en PNG, avec son prompt, sa graine et son modèle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni nuova immagine sarà salvata qui in PNG, con il suo prompt, il seme e il modello."
          }
        },
