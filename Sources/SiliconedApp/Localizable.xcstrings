    "Install it from the Models sheet (⇧⌘M), then import the file again: an import downloads nothing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installieren Sie es im Fenster „Modelle“ (⇧⌘M) und importieren Sie die Datei dann erneut: Ein Import lädt nichts herunter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instálalo desde la hoja Modelos (⇧⌘M) y vuelve a importar el archivo: una importación no descarga nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez-le depuis la feuille Modèles (⇧⌘M), puis importez à nouveau le fichier : un import ne télécharge rien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installalo dalla finestra Modelli (⇧⌘M), poi importa di nuovo il file: un’importazione non scarica nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「モデル」シート（⇧⌘M）からインストールしてから、ファイルをもう一度読み込んでください：読み込みではダウンロードは行われません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“模型”面板（⇧⌘M）中安装它，然后再次导入该文件：导入不会下载任何内容。"
          }
        }
      }
