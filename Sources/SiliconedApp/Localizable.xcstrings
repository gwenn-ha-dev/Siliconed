    "The rack takes this cell whole — model, prompt, size, steps, LoRAs, seed — without rendering" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Rack übernimmt diese Zelle vollständig – Modell, Prompt, Format, Schritte, LoRAs, Seed –, ohne zu rendern"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El rack toma la celda entera — modelo, prompt, tamaño, pasos, LoRA, semilla — sin renderizar"
