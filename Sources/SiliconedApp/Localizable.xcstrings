            "value" : "macOS télécharge le modèle d’agrandissement"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS sta scaricando il modello di ingrandimento"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSが拡大モデルをダウンロード中です"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
