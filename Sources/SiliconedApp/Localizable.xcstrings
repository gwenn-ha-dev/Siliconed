    "macOS is downloading the enlargement model" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS lädt das Vergrößerungsmodell"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS está descargando el modelo de ampliación"
          }
        },
        "fr" : {
          "stringUnit" : {
