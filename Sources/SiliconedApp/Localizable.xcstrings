        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ラベル付きで並べたスケッチ — 履歴の画像で、ほかの画像と同じくメモリ上にあります"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
