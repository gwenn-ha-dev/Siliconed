        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorre semillas, la intensidad de un LoRA, palabras del prompt, modelos o las imágenes que editar — pequeños bocetos, rápidos (⌥⌘G)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez des graines, la force d’une LoRA, des mots du prompt, des modèles ou les images à éditer — de petites esquisses, vite (⌥⌘G)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esplora semi, l’intensità di una LoRA, parole del prompt, modelli o le immagini da modificare — piccoli schizzi, veloci (⌥⌘G)"
          }
        }
      }
    },
