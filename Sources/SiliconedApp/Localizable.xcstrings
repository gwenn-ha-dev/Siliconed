    },
    "The library can't be found: %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bibliothek ist nicht zu finden: %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encuentra la biblioteca: %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bibliothèque est introuvable : %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La libreria non si trova: %@."
          }
        }
      }
    },
    "The library is on another disk: what a render reads is copied to this Mac first, once, and removed when Siliconed quits" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bibliothek liegt auf einer anderen Festplatte: Was ein Rendering liest, wird zuerst einmal auf diesen Mac kopiert und beim Beenden von Siliconed entfernt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La biblioteca está en otro disco: lo que lee un renderizado se copia primero a este Mac, una vez, y se borra al salir de Siliconed"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bibliothèque est sur un autre disque : ce qu’un rendu lit est d’abord copié sur ce Mac, une fois, et effacé quand Siliconed quitte"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La libreria è su un altro disco: ciò che un rendering legge viene prima copiato su questo Mac, una volta, e rimosso quando Siliconed si chiude"
          }
        }
      }
    },
    "The library is on “%@”, which isn't connected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bibliothek liegt auf „%@“, das nicht angeschlossen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La biblioteca está en «%@», que no está conectado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bibliothèque est sur « %@ », qui n’est pas branché."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La libreria è su «%@», che non è collegato."
          }
        }
      }
    },
    "The license asks whoever deploys the model to filter the content it makes (§ 4.2). Siliconed applies no filter: by installing the model and accepting its license, you take on that responsibility." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Lizenz verlangt von allen, die das Modell einsetzen, die erzeugten Inhalte zu filtern (§ 4.2). Siliconed wendet keinen Filter an: Wer das Modell installiert und seine Lizenz akzeptiert, übernimmt diese Verantwortung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La licencia pide a quien despliega el modelo que filtre el contenido que genera (§ 4.2). Siliconed no aplica ningún filtro: al instalar el modelo y aceptar su licencia, asumes esa responsabilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La licence demande à qui déploie le modèle de filtrer les contenus qu’il produit (§ 4.2). Siliconed n’applique aucun filtre : en installant le modèle et en acceptant sa licence, vous en prenez la responsabilité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La licenza chiede a chi distribuisce il modello di filtrare i contenuti che genera (§ 4.2). Siliconed non applica alcun filtro: installando il modello e accettandone la licenza, te ne assumi la responsabilità."
          }
        }
      }
    },
    "The license of %@ hasn't been accepted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Lizenz von %@ wurde nicht akzeptiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha aceptado la licencia de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La licence de %@ n’a pas été acceptée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La licenza di %@ non è stata accettata."
          }
        }
      }
    },
    "The license shown is not this Mac's text for %@: nothing was accepted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gezeigte Lizenz ist nicht der Text dieses Macs für %@: Nichts wurde akzeptiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La licencia mostrada no es el texto de este Mac para %@: no se aceptó nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La licence montrée n’est pas le texte de ce Mac pour %@ : rien n’a été accepté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La licenza mostrata non è il testo di questo Mac per %@: non è stato accettato nulla."
          }
        }
      }
    },
    "The look: medium, palette, lighting — not the content." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Look: Technik, Palette, Licht – nicht der Inhalt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El aspecto: técnica, paleta, luz; no el contenido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rendu : technique, palette, lumière — pas le contenu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’aspetto: tecnica, tavolozza, luce — non il contenuto."
          }
        }
      }
    },
    "The machine is busy: the timings are better left undisturbed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mac ist beschäftigt: Die Zeitmessungen sollten nicht gestört werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La máquina está ocupada: mejor no perturbar los tiempos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La machine travaille : mieux vaut ne pas déranger les chronos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La macchina è occupata: meglio non disturbare i tempi."
          }
        }
      }
    },
    "The machine profile couldn't be read as it is." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Geräteprofil konnte nicht unverändert gelesen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido leer el perfil de la máquina tal cual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le profil machine n’a pas pu être lu tel quel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere il profilo macchina così com’è."
          }
        }
      }
    },
    "The machine profile sets « %@ », which it may not: a profile tunes speed and room, never the image." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Geräteprofil setzt „%@“, was ihm nicht zusteht: Ein Profil regelt Geschwindigkeit und Platz, nie das Bild."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El perfil de la máquina ajusta «%@», y eso no le corresponde: un perfil ajusta la velocidad y el espacio, nunca la imagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le profil machine règle « %@ », ce qui ne lui revient pas : un profil règle la vitesse et la place, jamais l’image."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il profilo macchina imposta «%@», cosa che non gli spetta: un profilo regola velocità e spazio, mai l’immagine."
          }
        }
      }
    },
    "The measure of %@ was taken while the Mac was not at rest: it is measured again before the next render." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Messung vom %@ wurde nicht im Ruhezustand des Mac aufgenommen: Sie wird vor dem nächsten Rendern wiederholt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La medición del %@ se tomó con el Mac sin estar en reposo: se repite antes del próximo render."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mesure du %@ a été prise sur un Mac qui n’était pas au repos : elle est refaite avant le prochain rendu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La misura del %@ è stata presa con il Mac non a riposo: viene ripetuta prima del prossimo rendering."
          }
        }
      }
    },
    "The measure of %@ was taken with another macOS or another version of Siliconed: this Mac is measured again before the next render." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Messung vom %@ wurde mit einem anderen macOS oder einer anderen Version von Siliconed gemacht: Dieser Mac wird vor dem nächsten Rendering erneut gemessen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La medición del %@ se hizo con otro macOS u otra versión de Siliconed: este Mac se mide de nuevo antes del próximo renderizado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mesure du %@ a été prise avec un autre macOS ou une autre version de Siliconed : ce Mac est mesuré à nouveau avant le prochain rendu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La misura del %@ è stata presa con un altro macOS o un’altra versione di Siliconed: questo Mac viene misurato di nuovo prima del prossimo rendering."
          }
        }
      }
    },
    "The memory %@ needs at this size (computed)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
