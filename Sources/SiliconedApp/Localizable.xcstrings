            "state" : "translated",
            "value" : "Skizze bei %1$lld von %2$lld Schritten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sketch at %#@n@ of %2$lld"
          },
          "substitutions" : {
