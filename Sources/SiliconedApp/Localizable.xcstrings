    "How each step moves to the next, with the same steps: Euler is the one this model was distilled for" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie jeder Schritt zum nächsten führt, bei gleichen Schritten: Euler ist der, für den dieses Modell destilliert wurde"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo cada paso lleva al siguiente, con los mismos pasos: Euler es el que se usó al destilar este modelo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment chaque pas mène au suivant, avec les mêmes pas : Euler est celui pour lequel ce modèle a été distillé"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come ogni passo porta al successivo, con gli stessi passi: Euler è quello per cui questo modello è stato distillato"
          }
        }
      }
    },
    "How two images are compared in the canvas; its toolbar switches too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie zwei Bilder auf der Leinwand verglichen werden; ihre Symbolleiste schaltet ebenfalls um."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo se comparan dos imágenes en el lienzo; su barra de herramientas también lo cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment deux images se comparent dans le canevas ; sa barre d’outils bascule aussi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come si confrontano due immagini nella tela; anche la sua barra degli strumenti lo cambia."
          }
        }
      }
    },
    "Illustration, painting and anime. No photorealism: its publisher's choice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illustration, Malerei und Anime. Kein Fotorealismus: eine Entscheidung des Herausgebers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilustración, pintura y anime. Sin fotorrealismo: una decisión de su editor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illustration, peinture et anime. Pas de photoréalisme : un choix de son éditeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illustrazione, pittura e anime. Niente fotorealismo: una scelta del suo editore."
          }
        }
      }
    },
