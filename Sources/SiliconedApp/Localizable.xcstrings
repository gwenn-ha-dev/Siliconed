        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pasos son números enteros a partir de 1, una cuadrícula necesita al menos una semilla, y una intensidad de LoRA negativa necesita Experimental → Intensidades de LoRA negativas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
