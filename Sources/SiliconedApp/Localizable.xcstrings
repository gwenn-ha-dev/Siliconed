        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto ha appena impiegato questa fase"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このステージにいまかかった時間"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
