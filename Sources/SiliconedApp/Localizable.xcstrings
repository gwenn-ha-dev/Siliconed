          }
        }
      }
    },
    "Paired Macs render on this one, with its models. Nothing connects before you accept a pairing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gekoppelte Macs rendern auf diesem, mit seinen Modellen. Nichts verbindet sich, bevor Sie eine Kopplung annehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Mac emparejados renderizan en este, con sus modelos. Nada se conecta antes de que acepte un emparejamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Mac appairés calculent sur celui-ci, avec ses modèles. Rien ne se connecte avant que vous acceptiez un appairage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Mac abbinati generano su questo, con i suoi modelli. Nulla si collega prima che tu accetti un abbinamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアリングしたMacはこのMacとそのモデルで生成します。ペアリングを承認するまで何も接続されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配对的 Mac 会在这台 Mac 上使用它的模型进行生成。接受配对之前不会建立任何连接。"
          }
        }
      }
    },
