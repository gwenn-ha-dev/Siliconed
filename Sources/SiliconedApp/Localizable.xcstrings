    "Stopped — %@ can render again after a new installation: the %@ version was removed to make room. The files already downloaded are kept; the one in progress will start over." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestoppt – %1$@ kann nach einer neuen Installation wieder rendern: Die %2$@-Version wurde entfernt, um Platz zu schaffen. Bereits geladene Dateien bleiben erhalten; die gerade geladene beginnt von vorn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stopped — %1$@ can render again after a new installation: the %2$@ version was removed to make room. The files already downloaded are kept; the one in progress will start over."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detenido — %1$@ podrá volver a renderizar tras una nueva instalación: la versión %2$@ se eliminó para hacer sitio. Los archivos ya descargados se conservan; el que estaba en curso empezará de cero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêté — %1$@ pourra de nouveau rendre après une nouvelle installation : la version %2$@ a été retirée pour faire de la place. Les fichiers déjà téléchargés sont gardés ; celui en cours repartira de zéro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrotto — %1$@ potrà di nuovo eseguire rendering dopo una nuova installazione: la versione %2$@ è stata rimossa per fare spazio. I file già scaricati vengono conservati; quello in corso ripartirà da zero."
          }
        }
      }
    },
    "Stopped — the files already downloaded are kept; the one in progress will start over" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestoppt – bereits geladene Dateien bleiben erhalten; die gerade geladene beginnt von vorn"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detenido — los archivos ya descargados se conservan; el que estaba en curso empezará de cero"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêté — les fichiers déjà téléchargés sont gardés ; celui en cours repartira de zéro"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrotto — i file già scaricati vengono conservati; quello in corso ripartirà da zero"
          }
        }
      }
    },
    "Stopped — the library stays where it was, untouched. The files already copied are kept for the next attempt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestoppt – die Bibliothek bleibt unverändert, wo sie war. Bereits kopierte Dateien bleiben für den nächsten Versuch erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detenido — la biblioteca se queda donde estaba, intacta. Los archivos ya copiados se conservan para el próximo intento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêté — la bibliothèque reste où elle était, intacte. Les fichiers déjà copiés sont gardés pour la prochaine fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrotto — la libreria resta dov’era, intatta. I file già copiati vengono conservati per il prossimo tentativo."
          }
        }
      }
    },
