    "8-bit weights published by third parties: the image model from Comfy-Org (int8 convrot), the text encoder from unsloth (int8 convrot). Processor, VAE and turbo LoRA are the publisher's." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8-Bit-Gewichte, von Dritten veröffentlicht: das Bildmodell von Comfy-Org (int8 convrot), der Text-Encoder von unsloth (int8 convrot). Prozessor, VAE und Turbo-LoRA stammen vom Herausgeber."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesos de 8 bits publicados por terceros: el modelo de imagen, de Comfy-Org (int8 convrot); el codificador de texto, de unsloth (int8 convrot). El procesador, el VAE y el LoRA turbo son los del editor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poids 8 bits publiés par des tiers : le modèle d’image de Comfy-Org (int8 convrot), l’encodeur de texte d’unsloth (int8 convrot). Processeur, VAE et LoRA turbo sont ceux de l’éditeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesi a 8 bit pubblicati da terzi: il modello d’immagine da Comfy-Org (int8 convrot), l’encoder di testo da unsloth (int8 convrot). Processore, VAE e LoRA turbo sono quelli dell’editore."
          }
        }
      }
    },
    "8-bit weights published by third parties: the image model from unsloth (GGUF Q8_0), the text encoder from Disty0 (SDNQ int8). Tokenizer and VAE are the publisher's." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8-Bit-Gewichte, von Dritten veröffentlicht: das Bildmodell von unsloth (GGUF Q8_0), der Text-Encoder von Disty0 (SDNQ int8). Tokenizer und VAE stammen vom Herausgeber."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesos de 8 bits publicados por terceros: el modelo de imagen, de unsloth (GGUF Q8_0); el codificador de texto, de Disty0 (SDNQ int8). El tokenizador y el VAE son los del editor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poids 8 bits publiés par des tiers : le modèle d’image d’unsloth (GGUF Q8_0), l’encodeur de texte de Disty0 (SDNQ int8). Tokenizer et VAE sont ceux de l’éditeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesi a 8 bit pubblicati da terzi: il modello d’immagine da unsloth (GGUF Q8_0), l’encoder di testo da Disty0 (SDNQ int8). Tokenizer e VAE sono quelli dell’editore."
          }
        }
      }
    },
