    "An edit keeps the framing of image 1: about 1 megapixel at its proportions, each side at least 512, 1024² at most" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Bearbeitung behält den Bildausschnitt von Bild 1: etwa 1 Megapixel in seinen Proportionen, jede Seite mindestens 512, höchstens 1024²"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una edición conserva el encuadre de la imagen 1: alrededor de 1 megapíxel en sus proporciones, cada lado de al menos 512, 1024² como máximo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une édition garde le cadrage de l’image 1 : environ 1 mégapixel à ses proportions, chaque côté d’au moins 512, 1024² au plus"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una modifica mantiene l’inquadratura dell’immagine 1: circa 1 megapixel nelle sue proporzioni, ogni lato almeno 512, al massimo 1024²"
          }
        }
