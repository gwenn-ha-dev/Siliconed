    "Learned on this Mac: the first render at this size, with this model, sets the estimate" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Mac gelernt: Das erste Rendering in diesem Format mit diesem Modell legt die Schätzung fest"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendido en este Mac: el primer renderizado a este tamaño, con este modelo, fija la estimación"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appris sur ce Mac : le premier rendu à cette taille, avec ce modèle, fixe l’estimation"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
