    "Shows the image taking shape on the canvas after each step. It does not change the image." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt nach jedem Schritt, wie das Bild auf der Arbeitsfläche Gestalt annimmt. Das Bild selbst ändert sich dadurch nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra la imagen tomando forma en el lienzo tras cada paso. No cambia la imagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montre l’image qui prend forme sur le canevas après chaque pas. Cela ne change pas l’image."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra l’immagine che prende forma sul canvas dopo ogni passo. Non modifica l’immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステップごとに、画像ができていく様子をキャンバスに表示します。画像自体は変わりません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一步之后，在画布上显示图像逐渐成形的过程。这不会改变图像。"
          }
        }
      }
    },
    "Shows the license and the space it takes; nothing is downloaded before you accept" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die Lizenz und den Platzbedarf; nichts wird geladen, bevor Sie akzeptieren"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra la licencia y el espacio que ocupa; no se descarga nada antes de que aceptes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montre la licence et la place prise ; rien n’est téléchargé avant que vous acceptiez"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra la licenza e lo spazio occupato; nulla viene scaricato prima che tu accetti"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライセンスと必要な容量を表示します。同意するまで何もダウンロードされません"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示许可证和所占空间；接受之前不会下载任何内容"
          }
        }
      }
    },
