    "Vary a word: select it, or put the caret in it, then click — Generate renders each word you give" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Wort variieren: markieren oder die Einfügemarke hineinsetzen, dann klicken – „Generieren“ rendert jedes angegebene Wort"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variar una palabra: selecciónala o pon el cursor en ella y haz clic — «Generar» renderiza cada palabra que indiques"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faire varier un mot : sélectionnez-le, ou placez-y le curseur, puis cliquez — « Générer » rend chaque mot donné"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varia una parola: selezionala o mettici il cursore, poi fai clic — «Genera» rende ogni parola indicata"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "語を変化させる：語を選択するかカーソルを置いてクリック。「生成」が指定した各語で描画します"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "变换一个词：选中它或将光标放在其中，然后点按——“生成”会逐一渲染你给出的每个词"
          }
        }
      }
    },
