    "A model or a LoRA of a known family, as published (Civitai, Hugging Face). The encoder and VAE come with the family: there is nothing else to provide." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Modell oder eine LoRA einer bekannten Familie, wie veröffentlicht (Civitai, Hugging Face). Encoder und VAE kommen von der Familie: Sonst ist nichts bereitzustellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un modelo o un LoRA de una familia conocida, tal como se publica (Civitai, Hugging Face). El codificador y el VAE vienen con la familia: no hay que aportar nada más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un modèle ou une LoRA d’une famille connue, tel que publié (Civitai, Hugging Face). L’encodeur et le VAE viennent de la famille : il n’y a rien d’autre à fournir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un modello o una LoRA di una famiglia nota, così come pubblicati (Civitai, Hugging Face). L’encoder e il VAE vengono dalla famiglia: non serve fornire altro."
          }
        }
      }
    },
    "A render is in progress." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Rendering läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay un renderizado en curso."
          }
        },
