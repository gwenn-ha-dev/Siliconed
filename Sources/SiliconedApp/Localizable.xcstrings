            "state" : "translated",
            "value" : "没有名为 @%@ 的主体。"
          }
        }
      }
    },
    "Nobody answered on that Mac: nothing was removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Mac hat niemand geantwortet: Nichts wurde entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie respondió en ese Mac: no se quitó nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne n’a répondu sur ce Mac : rien n’a été retiré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno ha risposto su quel Mac: non è stato rimosso nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのMacで誰も応答しませんでした。何も削除されていません。"
          }
