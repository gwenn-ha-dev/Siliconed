    "± is how far apart identical calls were during the measure, for each engine and each set: the margin of its figures." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "± sagt, wie weit identische Aufrufe während der Messung auseinanderlagen, für jeden Motor und jedes Ensemble: die Spanne seiner Zahlen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "± indica cuánto se separaron las llamadas idénticas durante la medición, para cada motor y cada conjunto: el margen de sus cifras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le ± dit de combien des appels identiques ont différé pendant la mesure, pour chaque moteur et chaque ensemble : la marge de ses chiffres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "± dice di quanto si sono discostate le chiamate identiche durante la misura, per ogni motore e ogni insieme: il margine delle sue cifre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "±は、測定中に同一の呼び出しがどれだけ離れていたかを、エンジンごと・組み合わせごとに示します。数値の幅です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "± 表示测量期间相同调用之间相差多少，按每个引擎和每种组合给出：其数字的误差范围。"
          }
        }
      }
    },
