    "On This Mac" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Mac"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En este Mac"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur ce Mac"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su questo Mac"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMac上"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于这台 Mac"
          }
        }
      }
    },
    "On another disk: what a render reads is copied to this Mac first, once per session, and removed when Siliconed quits. The disk must be connected to render." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf einer anderen Festplatte: Was ein Rendering liest, wird zuerst auf diesen Mac kopiert, einmal pro Sitzung, und beim Beenden von Siliconed entfernt. Zum Rendern muss die Festplatte angeschlossen sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En otro disco: lo que lee un renderizado se copia primero a este Mac, una vez por sesión, y se borra al salir de Siliconed. El disco debe estar conectado para renderizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur un autre disque : ce qu’un rendu lit est d’abord copié sur ce Mac, une fois par session, et effacé quand Siliconed quitte. Le disque doit être branché pour rendre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su un altro disco: ciò che un rendering legge viene prima copiato su questo Mac, una volta per sessione, e rimosso quando Siliconed si chiude. Il disco deve essere collegato per i rendering."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のディスク上：生成が読み込むものは、まずこのMacにセッションごとに1回コピーされ、Siliconedを終了すると削除されます。生成するにはディスクを接続しておく必要があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于另一块磁盘：生成所读取的内容会先拷贝到这台 Mac，每次会话一次，并在 Siliconed 退出时移除。生成时必须连接该磁盘。"
          }
        }
      }
    },
    "On that Mac: Settings → Macs → Lend This Mac, then Pair a Mac…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf jenem Mac: Einstellungen → Macs → Diesen Mac ausleihen, dann Mac koppeln…"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ese Mac: Ajustes → Mac → Prestar este Mac, y luego Vincular un Mac…"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur ce Mac : Réglages → Mac → Prêter ce Mac, puis Appairer un Mac…"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su quel Mac: Impostazioni → Mac → Presta questo Mac, poi Abbina un Mac…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのMacで：「設定」→「Mac」→「このMacを貸し出す」、続いて「Macをペアリング…」。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在那台 Mac 上：设置 → Mac → 出借这台 Mac，然后选择“配对 Mac…”。"
          }
        }
      }
    },
    "On the other Mac: Settings → Macs → Pair With a Mac…, then choose “%@”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem anderen Mac: Einstellungen → Macs → Mit einem Mac koppeln…, dann „%@“ wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el otro Mac: Ajustes → Mac → Vincular con un Mac…, y luego elige «%@»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur l’autre Mac : Réglages → Mac → Appairer avec un Mac…, puis choisissez « %@ »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sull’altro Mac: Impostazioni → Mac → Abbina a un Mac…, poi scegli «%@»."
          }
        },
        "ja" : {
          "stringUnit" : {
