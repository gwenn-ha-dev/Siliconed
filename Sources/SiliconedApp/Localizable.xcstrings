            "value" : "Maximum annoncé par le silicium : %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Massimo dichiarato dal silicio: %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シリコンが示す最大値：%@"
