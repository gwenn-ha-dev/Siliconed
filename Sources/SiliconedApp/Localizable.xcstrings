    "Pair once, with a code shown on both screens." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal koppeln, mit einem Code auf beiden Bildschirmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empareje una vez, con un código mostrado en ambas pantallas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appairez-le une fois, avec un code affiché sur les deux écrans."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbina una volta, con un codice mostrato su entrambi gli schermi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方の画面に表示されるコードで一度ペアリングします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
