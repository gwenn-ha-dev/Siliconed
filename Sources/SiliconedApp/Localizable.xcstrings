        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那台 Mac 上无人应答：未移除任何内容。"
          }
        }
      }
    },
    "Non-commercial model: personal and research use only. Its images may be used commercially." : {
      "localizations" : {
