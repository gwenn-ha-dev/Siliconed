    "This session uses the measure of %@, which was not complete (its minute, its memory or a route judged wrong): it is measured again at its next launch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Sitzung verwendet die Messung vom %@, die nicht vollständig war (ihre Minute, ihr Speicher oder eine als falsch beurteilte Route): Sie wird beim nächsten Start wiederholt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sesión usa la medición del %@, que no estaba completa (su minuto, su memoria o una ruta juzgada errónea): se repite en el próximo arranque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette session utilise la mesure du %@, qui n’était pas complète (sa minute, sa mémoire ou une route jugée fausse) : elle est refaite à son prochain lancement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa sessione usa la misura del %@, che non era completa (il suo minuto, la sua memoria o un percorso giudicato errato): viene ripetuta al prossimo avvio."
          }
        },
        "ja" : {
          "stringUnit" : {
