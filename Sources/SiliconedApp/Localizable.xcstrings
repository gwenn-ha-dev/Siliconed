        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La memoria que necesita %@ a este tamaño (calculada)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mémoire qu’il faut à %@ à cette taille (calculée)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La memoria che serve a %@ a questa dimensione (calcolata)"
          }
        }
      }
    },
    "The memory %@ needs can't be computed: its files can't be read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Arbeitsspeicher, den %@ braucht, lässt sich nicht berechnen: seine Dateien sind nicht lesbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede calcular la memoria que necesita %@: sus archivos no se pueden leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mémoire qu’il faut à %@ ne peut pas être calculée : ses fichiers sont illisibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La memoria che serve a %@ non si può calcolare: i suoi file non sono leggibili."
          }
        }
      }
    },
    "The model reads them as <image1>, <image2>… in front of the prompt" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Modell liest sie als <image1>, <image2> … vor dem Prompt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo las lee como <image1>, <image2>… delante del prompt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle les lit comme <image1>, <image2>… devant le prompt"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modello le legge come <image1>, <image2>… davanti al prompt"
          }
        }
      }
    },
    "The model that draws (a diffusion transformer): from noise, step by step, it makes the image the prompt describes" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Modell, das zeichnet (ein Diffusion Transformer): aus Rauschen macht es Schritt für Schritt das Bild, das der Prompt beschreibt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo que dibuja (un transformer de difusión): a partir del ruido, paso a paso, crea la imagen que describe el prompt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle qui dessine (un transformeur de diffusion) : partant du bruit, pas à pas, il fait l’image que décrit le prompt"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modello che disegna (un transformer di diffusione): partendo dal rumore, passo dopo passo, crea l’immagine descritta dal prompt"
          }
        }
      }
    },
    "The models and LoRAs Siliconed installed. Remove a model from the Models window, not from the Finder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
