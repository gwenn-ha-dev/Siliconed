    "Accept the model's license on huggingface.co, then sign in on this Mac: “hf auth login” in a terminal, and install again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akzeptieren Sie die Lizenz des Modells auf huggingface.co, melden Sie sich dann auf diesem Mac an („hf auth login“ in einem Terminal) und installieren Sie erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acepta la licencia del modelo en huggingface.co y luego inicia sesión en este Mac: «hf auth login» en un terminal, y vuelve a instalar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceptez la licence du modèle sur huggingface.co, puis connectez-vous sur ce Mac : « hf auth login » dans un terminal, et relancez l’installation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accetta la licenza del modello su huggingface.co, poi accedi su questo Mac: «hf auth login» in un terminale, e riavvia l’installazione."
          }
        }
      }
    },
