    },
    "Paired Macs render on this one, with its models." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gekoppelte Macs rendern auf diesem, mit seinen Modellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Mac emparejados renderizan en este, con sus modelos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Mac appairés calculent sur celui-ci, avec ses modèles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Mac abbinati generano su questo, con i suoi modelli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアリングしたMacはこのMacとそのモデルで生成します。"
          }
        },
        "zh-Hans" : {
