    "Long, detailed prompts, read by a 9 B language model. Eight steps through the community's distillation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lange, detaillierte Prompts, gelesen von einem Sprachmodell mit 9 Milliarden Parametern. Acht Schritte dank der Destillation der Community."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prompts largos y detallados, leídos por un modelo de lenguaje de 9 mil millones de parámetros. Ocho pasos gracias a la destilación de la comunidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des prompts longs et détaillés, lus par un modèle de langage de 9 milliards de paramètres. Huit pas, grâce à la distillation de la communauté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prompt lunghi e dettagliati, letti da un modello linguistico da 9 miliardi di parametri. Otto passi grazie alla distillazione della comunità."
          }
        }
      }
    },
