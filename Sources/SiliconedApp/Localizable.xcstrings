    "Identical calls agreed to within these margins." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identische Aufrufe stimmten innerhalb dieser Spannen überein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las llamadas idénticas coincidieron dentro de estos márgenes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des appels identiques ont concordé à ces marges près."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chiamate identiche sono concordate entro questi margini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ処理の呼び出しは、この範囲内で一致しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相同的调用在这些误差范围内保持一致。"
          }
        }
      }
    },
    "Identical calls differed by more than a free Mac’s: those figures are read on their quick side." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identische Aufrufe wichen stärker ab als auf einem freien Mac: Diese Werte werden von der schnellen Seite gelesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las llamadas idénticas difirieron más que en un Mac libre: esas cifras se leen por su lado rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des appels identiques ont différé plus que sur un Mac libre : ces chiffres sont lus du côté rapide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chiamate identiche sono differite più che su un Mac libero: quei valori sono letti dal lato veloce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ処理の呼び出しの差が、空いているMacより大きくなりました：これらの値は速いほうの側から読み取っています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相同调用之间的差异比空闲的 Mac 更大：这些数值取自较快的一侧。"
          }
        }
      }
    },
    "Illustration, painting and anime. No photorealism: its publisher’s choice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illustration, Malerei und Anime. Kein Fotorealismus: eine Entscheidung des Herausgebers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilustración, pintura y anime. Sin fotorrealismo: una decisión de su editor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illustration, peinture et anime. Pas de photoréalisme : un choix de son éditeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illustrazione, pittura e anime. Niente fotorealismo: una scelta del suo editore."
