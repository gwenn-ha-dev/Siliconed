    "About a minute, five at most; done before the first render and after each update. A new measure applies to the next render." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa eine Minute, höchstens fünf; vor dem ersten Rendern und nach jedem Update. Eine neue Messung gilt für das nächste Rendern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alrededor de un minuto, cinco como mucho; se hace antes del primer render y tras cada actualización. Una nueva medición se aplica al siguiente render."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Environ une minute, cinq au plus ; faite avant le premier rendu et après chaque mise à jour. Une nouvelle mesure s’applique au rendu suivant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circa un minuto, cinque al massimo; fatta prima del primo render e dopo ogni aggiornamento. Una nuova misura si applica al render successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "約1分、長くても5分で、最初の生成の前とアップデートのたびに行われます。新しい測定は次の生成から適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大约一分钟，最多五分钟；在首次生成之前以及每次更新之后进行。新的测量会应用到下一次生成。"
          }
        }
      }
    },
