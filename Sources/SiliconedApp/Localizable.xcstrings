    },
    "Paired Macs render on this one, with its models. Nothing connects before you accept a pairing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gekoppelte Macs rendern auf diesem, mit seinen Modellen. Nichts verbindet sich, bevor Sie eine Kopplung annehmen."
          }
        },
        "es" : {
          "stringUnit" : {
