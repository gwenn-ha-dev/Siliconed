        }
      }
    },
    "Non-commercial: personal use and research only. Images made with it can't be sold or used in a commercial product." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht kommerziell: nur private Nutzung und Forschung. Damit erstellte Bilder dürfen weder verkauft noch in einem kommerziellen Produkt verwendet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No comercial: solo uso personal e investigación. Las imágenes creadas con él no se pueden vender ni usar en un producto comercial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non commercial : usage personnel et recherche seulement. Les images faites avec ne peuvent être ni vendues ni utilisées dans un produit commercial."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non commerciale: solo uso personale e ricerca. Le immagini create non possono essere vendute né usate in un prodotto commerciale."
          }
        }
      }
    },
    "Non-commercial: the model is for personal use and research only. The images it makes may be used for any purpose, commercial use included." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht kommerziell: Das Modell ist nur für private Nutzung und Forschung. Die damit erstellten Bilder dürfen für jeden Zweck genutzt werden, auch kommerziell."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No comercial: el modelo es solo para uso personal e investigación. Las imágenes que crea pueden usarse para cualquier fin, también comercial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non commercial : le modèle est réservé à l’usage personnel et à la recherche. Les images qu’il produit peuvent servir à tout usage, commercial compris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non commerciale: il modello è solo per uso personale e ricerca. Le immagini che crea possono essere usate per qualsiasi scopo, anche commerciale."
          }
        }
      }
