    "This Mac’s measure gives the accelerators nothing to do: the DiT is computed in fp32." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Messung dieses Macs gibt den Beschleunigern nichts zu tun: der DiT wird in fp32 berechnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La medición de este Mac no da nada que hacer a los aceleradores: el DiT se calcula en fp32."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mesure de ce Mac ne donne rien à faire aux accélérateurs : le DiT est calculé en fp32."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La misura di questo Mac non dà nulla da fare agli acceleratori: il DiT è calcolato in fp32."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacの測定では、アクセラレータに任せる処理がありません。DiTはfp32で計算されます。"
          }
