          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bibliothèque est sur « %@ », qui n’est pas branché."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
