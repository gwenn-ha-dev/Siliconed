          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo de imagen y el codificador de texto en la precisión del editor (bf16); la LoRA de 8 pasos de lodestones, en fp32. El VAE y el tokenizador son los del editor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle d’image et l’encodeur de texte dans la précision de l’éditeur (bf16) ; la LoRA à 8 pas de lodestones, en fp32. VAE et tokenizer sont ceux de l’éditeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modello d’immagine e l’encoder di testo nella precisione dell’editore (bf16); la LoRA a 8 passi di lodestones, in fp32. VAE e tokenizer sono quelli dell’editore."
