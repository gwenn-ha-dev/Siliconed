    "Image 1 is the one edited. The prompt can name them: “put the dog of image 2 next to the woman in image 1”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bild 1 ist das bearbeitete Bild. Der Prompt kann die Bilder benennen: „setze den Hund aus Bild 2 neben die Frau in Bild 1“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen 1 es la que se edita. El prompt puede nombrarlas: «pon el perro de la imagen 2 junto a la mujer de la imagen 1»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’image 1 est celle qu’on édite. Le prompt peut les nommer : « mets le chien de l’image 2 à côté de la femme de l’image 1 »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’immagine 1 è quella che viene modificata. Il prompt può nominarle: «metti il cane dell’immagine 2 accanto alla donna dell’immagine 1»."
          }
        }
      }
    },
