    "The measure of %@ was not complete (its minute, its memory or a route judged wrong): it is measured again before the next render." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Messung vom %@ war nicht vollständig (ihre Minute, ihr Speicher oder eine als falsch beurteilte Route): Sie wird vor dem nächsten Rendern wiederholt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La medición del %@ no estaba completa (su minuto, su memoria o una ruta juzgada errónea): se repite antes de la próxima imagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mesure du %@ n’était pas complète (sa minute, sa mémoire ou une route jugée fausse) : elle est refaite avant le prochain rendu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La misura del %@ non era completa (il suo minuto, la sua memoria o un percorso giudicato errato): viene ripetuta prima della prossima immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の測定は完了していません（時間、メモリ、または誤りと判定された経路）。次のレンダリングの前に再測定します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的测量未完成（一分钟的时限、内存或某条被判定有误的路径）：将在下次生成之前重新测量。"
          }
        }
      }
    },
    "The measure of %@ was taken with another macOS or another version of Siliconed: this Mac is measured again before the next render." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Messung vom %@ wurde mit einem anderen macOS oder einer anderen Version von Siliconed gemacht: Dieser Mac wird vor dem nächsten Rendering erneut gemessen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La medición del %@ se hizo con otro macOS u otra versión de Siliconed: este Mac se mide de nuevo antes del próximo renderizado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mesure du %@ a été prise avec un autre macOS ou une autre version de Siliconed : ce Mac est mesuré à nouveau avant le prochain rendu."
