          }
        }
      }
    },
    "The image model in 4 to 5 bits, published by vantagewithai (GGUF Q4_K_M); the Compact's 8-bit text encoder, from Comfy-Org (int8 convrot). VAE and tokenizer as in the Standard version." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bildmodell in 4 bis 5 Bit, veröffentlicht von vantagewithai (GGUF Q4_K_M); der 8-Bit-Text-Encoder der Compact, von Comfy-Org (int8 convrot). VAE und Tokenizer wie in der Standard-Version."
          }
        },
        "es" : {
          "stringUnit" : {
