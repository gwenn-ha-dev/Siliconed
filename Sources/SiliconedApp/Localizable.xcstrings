    "Variations: cousins of this image, same scene, slightly different — as many as the rack’s Batch" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variationen: Verwandte dieses Bilds, gleiche Szene, leicht anders – so viele, wie das Feld „Anzahl“ des Racks angibt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variaciones: primas de esta imagen, misma escena, algo distintas — tantas como indique el campo Lote del rack"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variations : des cousines de cette image, même scène, un peu différentes — autant que le champ Lot du rack"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variazioni: parenti di questa immagine, stessa scena, leggermente diverse — tante quante indica il campo Lotto del rack"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バリエーション：この画像の仲間で、同じシーンを少しずつ変えたもの — ラックの「バッチ」の枚数だけ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
