    "Image 1 is the one edited and gives the format. The rack takes 3 images at most." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bild 1 ist das bearbeitete Bild und gibt das Format vor. Das Rack nimmt höchstens 3 Bilder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen 1 es la que se edita y da el formato. El rack admite 3 imágenes como máximo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’image 1 est celle qu’on édite, et elle donne le format. Le rack prend 3 images au plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’immagine 1 è quella che viene modificata e dà il formato. Il rack accetta al massimo 3 immagini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集されるのは画像1で、サイズもこれで決まります。ラックに入れられる画像は最大3枚です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图像 1 是被编辑的那一张，并决定尺寸。机架最多接收 3 张图像。"
          }
        }
      }
    },
    "Image 1 is the one edited. The prompt can name them: “put the dog of image 2 next to the woman in image 1”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bild 1 ist das bearbeitete Bild. Der Prompt kann die Bilder benennen: „setze den Hund aus Bild 2 neben die Frau in Bild 1“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen 1 es la que se edita. El prompt puede nombrarlas: «pon el perro de la imagen 2 junto a la mujer de la imagen 1»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’image 1 est celle qu’on édite. Le prompt peut les nommer : « mets le chien de l’image 2 à côté de la femme de l’image 1 »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’immagine 1 è quella che viene modificata. Il prompt può nominarle: «metti il cane dell’immagine 2 accanto alla donna dell’immagine 1»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集されるのは画像1です。プロンプトでそれぞれを指定できます：「画像2の犬を画像1の女性の隣に置いて」。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图像 1 是被编辑的那一张。提示词可以按序号指代它们：“把图像 2 里的狗放到图像 1 的女人旁边”。"
          }
        }
      }
    },
